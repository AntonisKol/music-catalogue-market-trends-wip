<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The nightly run on a Mac. Install with ops/install-launchd.sh, which fills in
     PROJECT_DIR. launchd starts it at 03:00 local time; if the Mac was asleep
     then, it runs when the Mac wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adnsaudio.market-trends.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>PROJECT_DIR/.venv/bin/python</string>
    <string>-m</string>
    <string>ingestion.nightly</string>
  </array>
  <key>WorkingDirectory</key>
  <string>PROJECT_DIR</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <!-- The command writes its own rotating log in logs/; this catches anything else. -->
  <key>StandardOutPath</key>
  <string>PROJECT_DIR/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>PROJECT_DIR/logs/launchd.log</string>
</dict>
</plist>
