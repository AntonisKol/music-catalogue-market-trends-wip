# The settings the server's .env needs, without their values. Copy this to
# /srv/market-trends/.env on the server and fill it in there; never commit it.

# Database (the same names as on the Mac; POSTGRES_HOST and POSTGRES_PORT are set by deploy/compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_READER_USER=
POSTGRES_READER_PASSWORD=
POSTGRES_LIMITS_USER=
POSTGRES_LIMITS_PASSWORD=

# Discogs, for the nightly update
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=

# The question service
ANTHROPIC_API_KEY=

# The web API
# TURNSTILE_SECRET_KEY: the live widget's secret key, not the test key.
# VISITOR_HASH_SECRET: a long random string, for example from: openssl rand -hex 32
TURNSTILE_SECRET_KEY=
VISITOR_HASH_SECRET=
ALLOWED_ORIGINS=https://adnsaudio.com
PUBLIC_API_URL=https://api.adnsaudio.com
SIGN_IN_RETURN_URL=https://adnsaudio.com/market-trends/

# Sign-up confirmation emails, from Resend
RESEND_API_KEY=
SIGN_IN_EMAIL_FROM=Market Trends <sign-in@adnsaudio.com>
# Operator mailbox for incoming label-request notifications.
LABEL_REQUEST_NOTIFICATION_EMAIL=

# Backups: the Storage Box folder the nightly dumps are copied to, for example
# u123456@u123456.your-storagebox.de:market-trends
# Keep comments on their own lines: backup.sh reads everything after the = as the value.
BACKUP_TARGET=
